generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DATABASE_URL")
}

// ── Auth.js v5 required models ────────────────────────────────────────────────

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String? @db.Text
  access_token      String? @db.Text
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String? @db.Text
  session_state     String?
  user              User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
  @@index([userId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

// ── Core user & multi-tenant models ──────────────────────────────────────────

model User {
  id            String    @id @default(cuid())
  email         String    @unique
  name          String?
  emailVerified DateTime?
  image         String?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  accounts            Account[]
  sessions            Session[]
  memberships         OrgMembership[]
  invitations         Invitation[]        @relation("InvitationCreatedBy")
  diaryEntries        DailyDiary[]        @relation("DiaryCreatedBy")
  notes               ProjectNote[]       @relation("NoteCreatedBy")
  financialEntries    FinancialEntry[]    @relation("FinancialEntryCreatedBy")
  inspections         Inspection[]        @relation("InspectionCreatedBy")
  issues              ProjectIssue[]      @relation("IssueCreatedBy")
  safetyIncidents     SafetyIncident[]    @relation("IncidentCreatedBy")
  checklistItems      ChecklistItem[]     @relation("ChecklistCreatedBy")
  tasks               ProjectTask[]       @relation("TaskCreatedBy")
  documents           ProjectDocument[]   @relation("DocCreatedBy")
  workers             Worker[]            @relation("WorkerCreatedBy")
  materials           MaterialItem[]      @relation("MaterialCreatedBy")
  siteReports         SiteReport[]        @relation("SiteReportCreatedBy")
  billingStatements   BillingStatement[]  @relation("BillingCreatedBy")
  sitePhotos          SitePhoto[]         @relation("PhotoCreatedBy")
  subcontractors      Subcontractor[]     @relation("SubcontractorCreatedBy")
  materialDeliveries  MaterialDelivery[]  @relation("DeliveryCreatedBy")
  teamMembers         ProjectTeamMember[] @relation("TeamMemberCreatedBy")
}

model Organization {
  id        String   @id @default(cuid())
  name      String
  slug      String   @unique
  logoUrl   String?
  plan      String   @default("free") // free | pro | enterprise
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  members     OrgMembership[]
  projects    Project[]
  rateItems   RateItem[]
  invitations Invitation[]
}

enum OrgRole {
  OWNER
  ESTIMATOR
  VIEWER
}

model OrgMembership {
  id       String   @id @default(cuid())
  userId   String
  orgId    String
  role     OrgRole  @default(VIEWER)
  joinedAt DateTime @default(now())

  user User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  org  Organization @relation(fields: [orgId], references: [id], onDelete: Cascade)

  @@unique([userId, orgId])
  @@index([orgId])
}

model Invitation {
  id          String   @id @default(cuid())
  orgId       String
  email       String
  role        OrgRole  @default(ESTIMATOR)
  token       String   @unique @default(cuid())
  expiresAt   DateTime
  acceptedAt  DateTime?
  createdById String
  createdAt   DateTime @default(now())

  org       Organization @relation(fields: [orgId], references: [id], onDelete: Cascade)
  createdBy User         @relation("InvitationCreatedBy", fields: [createdById], references: [id])

  @@unique([orgId, email])
  @@index([token])
}

// ── Projects ──────────────────────────────────────────────────────────────────

enum ProjectStatus {
  DRAFT
  ACTIVE
  ON_HOLD
  COMPLETED
  ARCHIVED
}

enum ContractType {
  PRIVATE
  GOVERNMENT
}

model Project {
  id          String        @id @default(cuid())
  orgId       String
  code        String?
  name        String
  client      String?
  location    String?
  region      String?       // DPWH region or administrative region
  contractType ContractType @default(PRIVATE)
  philgepsRef String?       // PhilGEPS reference number (gov projects)
  permitNumber String?       // building/environmental permit
  status      ProjectStatus @default(DRAFT)
  description String?       @db.Text
  startDate   DateTime?
  endDate     DateTime?
  budget      Decimal?      @db.Decimal(18, 2)  // client-approved budget
  contractAmount Decimal?   @db.Decimal(18, 2)  // awarded contract amount
  overheadPct Decimal       @default(0) @db.Decimal(5, 2)
  profitPct   Decimal       @default(0) @db.Decimal(5, 2)
  vatPct      Decimal       @default(12) @db.Decimal(5, 2) // PH VAT default 12%
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt

  org                 Organization          @relation(fields: [orgId], references: [id], onDelete: Cascade)
  wbsItems            WbsItem[]
  rateOverrides       ProjectRateOverride[]
  diaryEntries        DailyDiary[]
  notes               ProjectNote[]
  financialEntries    FinancialEntry[]
  inspections         Inspection[]
  issues              ProjectIssue[]
  safetyIncidents     SafetyIncident[]
  checklistItems      ChecklistItem[]
  tasks               ProjectTask[]
  documents           ProjectDocument[]
  workers             Worker[]
  materials           MaterialItem[]
  siteReports         SiteReport[]
  billingStatements   BillingStatement[]
  sitePhotos          SitePhoto[]
  subcontractors      Subcontractor[]
  materialDeliveries  MaterialDelivery[]
  teamMembers         ProjectTeamMember[]

  @@index([orgId])
  @@index([status])
}

// ── Workers / Roster ──────────────────────────────────────────────────────────

model Worker {
  id        String   @id @default(cuid())
  projectId String
  name      String
  role      String?
  dailyRate Decimal? @db.Decimal(18, 2)
  phone     String?
  isActive  Boolean  @default(true)
  createdById String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  project   Project @relation(fields: [projectId], references: [id], onDelete: Cascade)
  createdBy User    @relation("WorkerCreatedBy", fields: [createdById], references: [id])

  @@index([projectId])
}

// ── Materials / Inventory ─────────────────────────────────────────────────────

model MaterialItem {
  id          String   @id @default(cuid())
  projectId   String
  name        String
  unit        String?
  quantity    Decimal  @default(0) @db.Decimal(18, 4)
  minQuantity Decimal? @db.Decimal(18, 4)
  unitCost    Decimal? @db.Decimal(18, 2)
  location    String?
  isOnBuyList Boolean  @default(false)
  qtyNeeded   Decimal? @db.Decimal(18, 4)
  createdById String
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  project   Project @relation(fields: [projectId], references: [id], onDelete: Cascade)
  createdBy User    @relation("MaterialCreatedBy", fields: [createdById], references: [id])

  @@index([projectId])
}

// ── Document Control ──────────────────────────────────────────────────────────

enum DocType {
  SUBMITTAL
  RFI
  TRANSMITTAL
}

enum DocStatus {
  PENDING
  APPROVED
  REJECTED
  CLOSED
}

model ProjectDocument {
  id          String    @id @default(cuid())
  projectId   String
  type        DocType
  number      String?
  title       String
  description String?   @db.Text
  from        String?
  to          String?
  date        DateTime  @db.Date
  status      DocStatus @default(PENDING)
  response    String?   @db.Text
  createdById String
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  project   Project @relation(fields: [projectId], references: [id], onDelete: Cascade)
  createdBy User    @relation("DocCreatedBy", fields: [createdById], references: [id])

  @@index([projectId])
  @@index([type])
}

// ── Safety Incidents ──────────────────────────────────────────────────────────

enum IncidentSeverity {
  CRITICAL
  HIGH
  MEDIUM
  LOW
}

enum IncidentStatus {
  OPEN
  CLOSED
}

model SafetyIncident {
  id              String           @id @default(cuid())
  projectId       String
  title           String
  description     String?          @db.Text
  severity        IncidentSeverity @default(MEDIUM)
  status          IncidentStatus   @default(OPEN)
  incidentDate    DateTime         @db.Date
  location        String?
  injuredPerson   String?
  correctiveAction String?         @db.Text
  closedAt        DateTime?
  createdById     String
  createdAt       DateTime         @default(now())
  updatedAt       DateTime         @updatedAt

  project   Project @relation(fields: [projectId], references: [id], onDelete: Cascade)
  createdBy User    @relation("IncidentCreatedBy", fields: [createdById], references: [id])

  @@index([projectId])
  @@index([status])
}

// ── Activity Checklist ────────────────────────────────────────────────────────

model ChecklistItem {
  id          String    @id @default(cuid())
  projectId   String
  description String
  category    String?
  isCompleted Boolean   @default(false)
  completedAt DateTime?
  sortOrder   Int       @default(0)
  createdById String
  createdAt   DateTime  @default(now())

  project   Project @relation(fields: [projectId], references: [id], onDelete: Cascade)
  createdBy User    @relation("ChecklistCreatedBy", fields: [createdById], references: [id])

  @@index([projectId])
}

// ── Project Schedule / Tasks ──────────────────────────────────────────────────

enum TaskStatus {
  TODO
  IN_PROGRESS
  DONE
  OVERDUE
}

model ProjectTask {
  id          String     @id @default(cuid())
  projectId   String
  title       String
  description String?    @db.Text
  assignee    String?
  dueDate     DateTime?  @db.Date
  status      TaskStatus @default(TODO)
  sortOrder   Int        @default(0)
  createdById String
  createdAt   DateTime   @default(now())
  updatedAt   DateTime   @updatedAt

  project   Project @relation(fields: [projectId], references: [id], onDelete: Cascade)
  createdBy User    @relation("TaskCreatedBy", fields: [createdById], references: [id])

  @@index([projectId])
  @@index([status])
}

enum InspectionStatus {
  OPEN
  PASSED
  FAILED
}

model Inspection {
  id          String           @id @default(cuid())
  projectId   String
  title       String
  location    String?
  inspector   String?
  date        DateTime         @db.Date
  status      InspectionStatus @default(OPEN)
  notes       String?          @db.Text
  createdById String
  createdAt   DateTime         @default(now())
  updatedAt   DateTime         @updatedAt

  project   Project      @relation(fields: [projectId], references: [id], onDelete: Cascade)
  createdBy User         @relation("InspectionCreatedBy", fields: [createdById], references: [id])
  issues    ProjectIssue[]

  @@index([projectId])
}

enum IssueSeverity {
  CRITICAL
  HIGH
  MEDIUM
  LOW
}

enum IssueStatus {
  OPEN
  RESOLVED
}

model ProjectIssue {
  id            String        @id @default(cuid())
  projectId     String
  inspectionId  String?
  title         String
  description   String?       @db.Text
  severity      IssueSeverity @default(MEDIUM)
  status        IssueStatus   @default(OPEN)
  resolvedAt    DateTime?
  resolvedNotes String?       @db.Text
  createdById   String
  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt

  project    Project     @relation(fields: [projectId], references: [id], onDelete: Cascade)
  inspection Inspection? @relation(fields: [inspectionId], references: [id], onDelete: SetNull)
  createdBy  User        @relation("IssueCreatedBy", fields: [createdById], references: [id])

  @@index([projectId])
  @@index([status])
}

enum FinancialEntryType {
  ADDITION
  SUBTRACTION
}

model FinancialEntry {
  id          String             @id @default(cuid())
  projectId   String
  type        FinancialEntryType
  description String
  amount      Decimal            @db.Decimal(18, 2)
  date        DateTime           @db.Date
  createdById String
  createdAt   DateTime           @default(now())

  project   Project @relation(fields: [projectId], references: [id], onDelete: Cascade)
  createdBy User    @relation("FinancialEntryCreatedBy", fields: [createdById], references: [id])

  @@index([projectId])
}

model DailyDiary {
  id            String   @id @default(cuid())
  projectId     String
  date          DateTime @db.Date
  weather       String?
  manpowerCount Int?
  progress      String   @db.Text
  challenges    String?  @db.Text
  nextDayPlan   String?  @db.Text
  createdById   String
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  project   Project @relation(fields: [projectId], references: [id], onDelete: Cascade)
  createdBy User    @relation("DiaryCreatedBy", fields: [createdById], references: [id])

  @@unique([projectId, date])
  @@index([projectId])
}

model ProjectNote {
  id          String   @id @default(cuid())
  projectId   String
  title       String
  content     String   @db.Text
  isPinned    Boolean  @default(false)
  createdById String
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  project   Project @relation(fields: [projectId], references: [id], onDelete: Cascade)
  createdBy User    @relation("NoteCreatedBy", fields: [createdById], references: [id])

  @@index([projectId])
}

// ── Work Breakdown Structure ──────────────────────────────────────────────────

model WbsItem {
  id          String   @id @default(cuid())
  projectId   String
  parentId    String?
  wbsCode     String?            // e.g. "1.2.3" — auto-maintained
  description String
  unit        String?            // m, m2, m3, kg, pcs, ls, set, day, hr...
  formula     String?  @db.Text  // e.g. "L * W * H" — evaluated client-side
  quantity    Decimal? @db.Decimal(18, 4)
  remarks     String?  @db.Text
  isGroup     Boolean  @default(false)
  isLocked    Boolean  @default(false)
  sortOrder   Int      @default(0)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  project   Project    @relation(fields: [projectId], references: [id], onDelete: Cascade)
  parent    WbsItem?   @relation("WbsTree", fields: [parentId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  children  WbsItem[]  @relation("WbsTree")
  variables WbsVariable[]
  lineItems EstimateLineItem[]

  @@index([projectId])
  @@index([parentId])
}

model WbsVariable {
  id        String   @id @default(cuid())
  wbsItemId String
  name      String   // e.g. "L", "Width", "Height" — used in formula
  label     String?  // human-readable label
  value     Decimal  @db.Decimal(18, 4)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  wbsItem WbsItem @relation(fields: [wbsItemId], references: [id], onDelete: Cascade)

  @@unique([wbsItemId, name])
  @@index([wbsItemId])
}

// ── Rate Library ──────────────────────────────────────────────────────────────

enum RateCategory {
  LABOR
  MATERIAL
  EQUIPMENT
  SUBCONTRACT
  OTHER
}

model RateItem {
  id          String       @id @default(cuid())
  orgId       String
  code        String?
  description String
  category    RateCategory
  unit        String
  unitRate    Decimal      @db.Decimal(18, 4)
  isActive    Boolean      @default(true)
  notes       String?      @db.Text
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt

  org       Organization          @relation(fields: [orgId], references: [id], onDelete: Cascade)
  overrides ProjectRateOverride[]
  lineItems EstimateLineItem[]

  @@index([orgId])
  @@index([category])
}

model ProjectRateOverride {
  id         String   @id @default(cuid())
  projectId  String
  rateItemId String
  unitRate   Decimal  @db.Decimal(18, 4)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  project  Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)
  rateItem RateItem @relation(fields: [rateItemId], references: [id], onDelete: Cascade)

  @@unique([projectId, rateItemId])
  @@index([projectId])
}

// ── Estimate Line Items ───────────────────────────────────────────────────────

model EstimateLineItem {
  id         String   @id @default(cuid())
  wbsItemId  String
  rateItemId String
  quantity   Decimal? @db.Decimal(18, 4) // null = inherit WbsItem.quantity
  sortOrder  Int      @default(0)
  notes      String?
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  wbsItem  WbsItem  @relation(fields: [wbsItemId], references: [id], onDelete: Cascade)
  rateItem RateItem @relation(fields: [rateItemId], references: [id])

  @@index([wbsItemId])
  @@index([rateItemId])
}

// ── Site Reports ──────────────────────────────────────────────────────────────

model SiteReport {
  id          String   @id @default(cuid())
  projectId   String
  date        DateTime @db.Date
  weather     String?
  temperature String?
  manpower    Int?
  equipment   String?  @db.Text
  workDone    String   @db.Text
  materials   String?  @db.Text
  visitors    String?
  issues      String?  @db.Text
  notes       String?  @db.Text
  createdById String
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  project   Project @relation(fields: [projectId], references: [id], onDelete: Cascade)
  createdBy User    @relation("SiteReportCreatedBy", fields: [createdById], references: [id])

  @@unique([projectId, date])
  @@index([projectId])
}

// ── Progress Billing ──────────────────────────────────────────────────────────

enum BillingStatus {
  DRAFT
  SENT
  PAID
  CANCELLED
}

model BillingStatement {
  id          String        @id @default(cuid())
  projectId   String
  number      String?
  periodStart DateTime?     @db.Date
  periodEnd   DateTime?     @db.Date
  date        DateTime      @db.Date
  amount      Decimal       @db.Decimal(18, 2)
  paidAmount  Decimal       @default(0) @db.Decimal(18, 2)
  status      BillingStatus @default(DRAFT)
  notes       String?       @db.Text
  createdById String
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt

  project   Project @relation(fields: [projectId], references: [id], onDelete: Cascade)
  createdBy User    @relation("BillingCreatedBy", fields: [createdById], references: [id])

  @@index([projectId])
}

// ── Photo Log ─────────────────────────────────────────────────────────────────

enum PhotoCategory {
  PROGRESS
  DEFECT
  AS_BUILT
  SAFETY
  OTHER
}

model SitePhoto {
  id          String        @id @default(cuid())
  projectId   String
  url         String
  caption     String?
  category    PhotoCategory @default(PROGRESS)
  location    String?
  takenAt     DateTime      @db.Date
  createdById String
  createdAt   DateTime      @default(now())

  project   Project @relation(fields: [projectId], references: [id], onDelete: Cascade)
  createdBy User    @relation("PhotoCreatedBy", fields: [createdById], references: [id])

  @@index([projectId])
  @@index([category])
}

// ── Subcontractors ────────────────────────────────────────────────────────────

enum SubcontractorStatus {
  ACTIVE
  COMPLETED
  ON_HOLD
  TERMINATED
}

model Subcontractor {
  id            String              @id @default(cuid())
  projectId     String
  company       String
  trade         String?
  contactName   String?
  contactEmail  String?
  contactPhone  String?
  contractValue Decimal?            @db.Decimal(18, 2)
  paidAmount    Decimal             @default(0) @db.Decimal(18, 2)
  status        SubcontractorStatus @default(ACTIVE)
  notes         String?             @db.Text
  createdById   String
  createdAt     DateTime            @default(now())
  updatedAt     DateTime            @updatedAt

  project   Project @relation(fields: [projectId], references: [id], onDelete: Cascade)
  createdBy User    @relation("SubcontractorCreatedBy", fields: [createdById], references: [id])

  @@index([projectId])
}

// ── Material Deliveries ───────────────────────────────────────────────────────

model MaterialDelivery {
  id           String   @id @default(cuid())
  projectId    String
  supplier     String
  material     String
  quantity     Decimal  @db.Decimal(18, 4)
  unit         String?
  deliveryDate DateTime @db.Date
  receivedBy   String?
  drNumber     String?
  notes        String?  @db.Text
  createdById  String
  createdAt    DateTime @default(now())

  project   Project @relation(fields: [projectId], references: [id], onDelete: Cascade)
  createdBy User    @relation("DeliveryCreatedBy", fields: [createdById], references: [id])

  @@index([projectId])
}

// ── Project Team Members ──────────────────────────────────────────────────────

enum TeamRole {
  PROJECT_MANAGER
  ENGINEER
  FOREMAN
  SUPERVISOR
  SAFETY_OFFICER
  INSPECTOR
  OTHER
}

model ProjectTeamMember {
  id          String   @id @default(cuid())
  projectId   String
  name        String
  role        TeamRole @default(OTHER)
  email       String?
  phone       String?
  company     String?
  isActive    Boolean  @default(true)
  createdById String
  createdAt   DateTime @default(now())

  project   Project @relation(fields: [projectId], references: [id], onDelete: Cascade)
  createdBy User    @relation("TeamMemberCreatedBy", fields: [createdById], references: [id])

  @@index([projectId])
}
